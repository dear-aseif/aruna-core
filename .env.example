# Aruna Core — runtime configuration contract (names only; placeholder values).
# Copy to .env.local and fill in. Never commit real values.
# Contract per design.md "Auth and operations contract": database connection
# strings per role, the Auth.js secret, the Bedrock adapter configuration,
# and the cron secret.

# --- Database (PostgreSQL, one connection string per role; used from task 1.3) ---
DATABASE_URL_MIGRATOR=postgresql://migrator:CHANGE_ME@localhost:5432/aruna
DATABASE_URL_APP=postgresql://aruna_app:CHANGE_ME@localhost:5432/aruna
DATABASE_URL_SERVICE=postgresql://aruna_service:CHANGE_ME@localhost:5432/aruna

# --- Auth.js (used from task 2.2) ---
AUTH_SECRET=CHANGE_ME_generate_a_long_random_value
AUTH_URL=http://localhost:3000

# --- Model Gateway: Amazon Bedrock adapter (used from task 5.2) ---
BEDROCK_REGION=CHANGE_ME
BEDROCK_MODEL_ID=CHANGE_ME
# Credentials come from the AWS default credential chain / instance role,
# not from this file.

# --- Cron / routine endpoints (never public; used from task 4.3) ---
CRON_SECRET=CHANGE_ME_generate_a_long_random_value

# --- Public site URL (used for PWA/metadata) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
