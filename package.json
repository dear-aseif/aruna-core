{
  "name": "aruna-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "proof:render": "RENDER_PROOF=1 playwright test tests/e2e/render-proof.spec.ts",
    "proof:render:board": "RENDER_PROOF=1 playwright test tests/e2e/board-render-proof.spec.ts",
    "proof:render:detail": "RENDER_PROOF=1 playwright test tests/e2e/task-detail-render-proof.spec.ts",
    "proof:render:chat": "RENDER_PROOF=1 playwright test tests/e2e/chat-settings-render-proof.spec.ts",
    "proof:render:briefings": "RENDER_PROOF=1 playwright test tests/e2e/briefings-render-proof.spec.ts",
    "db:bootstrap-roles": "tsx --env-file=.env.local scripts/bootstrap-roles.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:check": "tsx --env-file=.env.local scripts/db-check.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "tasks:sweep": "tsx --env-file=.env.local scripts/expire-approvals.ts",
    "routines:run": "tsx --env-file=.env.local scripts/run-routines.ts",
    "tasks:recover": "tsx --env-file=.env.local scripts/recover-stale-attempts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "argon2": "^0.45.2",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
