# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build
/dist

# environment variables — never commit secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# tooling & misc
coverage/
.vercel
.DS_Store
*.pem
# Exception: the AWS RDS CA bundle is a public certificate file, not a secret.
# src/server/db/config.ts loads it by default, so it must be committed.
!db/certs/*.pem
.idea/
.vscode/*
!.vscode/extensions.json
/test-results/
/playwright-report/
*.tsbuildinfo
next-env.d.ts
